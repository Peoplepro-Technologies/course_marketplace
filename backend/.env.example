# ──────────────────────────────────────────────
# Course Marketplace — Backend Environment Vars
# ──────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_marketplace

# Redis connection string
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Keycloak settings
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=course-marketplace
KEYCLOAK_CLIENT_ID=course-frontend

# FFmpeg configuration (binary name on PATH or absolute path to ffmpeg executable)
FFMPEG_PATH=ffmpeg
